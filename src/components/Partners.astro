---
import { Image } from 'astro:assets';
import {
	clientPartnerLogoAlt,
	clientPartners as partners,
} from '../data/partners';
import { buildClientPartnersSchema } from '../lib/schema-clients';
import { getPublicOrigin } from '../lib/site-urls';
import FaIcon from './icons/FaIcon.astro';
import SectionHeading from './ui/SectionHeading.astro';

// Дублируем для бесшовного marquee
const row1 = [...partners, ...partners];

const logoScaleStyle = (scale?: number) =>
	scale ? `transform: scale(${scale})` : undefined;

const stats = [
	{
		text: 'Все услуги в рамках одного корпоративного договора',
		icon: 'fa6-solid:briefcase',
	},
	{
		text: 'Оптимизация расходов компании на командировки',
		icon: 'fa6-solid:chart-line',
	},
	{ text: 'Оперативная поддержка 24/7', icon: 'fa6-solid:headset' },
	{
		text: 'ЭДО и своевременные закрывающие документы',
		icon: 'fa6-solid:file-invoice',
	},
];

const baseUrl = getPublicOrigin(
	Astro.request,
	Astro.url.origin,
	Astro.site?.origin,
);
const clientsSchema = buildClientPartnersSchema(baseUrl, partners);

interface Props {
	class?: string;
}
const { class: classes = '' }: Props = Astro.props;
---

<section
	id="partners"
	class={`relative py-[50px] overflow-hidden ${classes}`}
	aria-labelledby="partners-heading"
>
	<!-- SEO: канонический индекс клиентов -->
	<div class="sr-only">
		<h3 id="partners-index">Корпоративные клиенты ANRO TRIP</h3>
		<ul>
			{
				partners.map((partner) => (
					<li>
						<Image
							src={partner.logo}
							alt={clientPartnerLogoAlt(partner)}
							width={partner.logo.width}
							height={partner.logo.height}
							loading="lazy"
							decoding="async"
						/>
					</li>
				))
			}
		</ul>
	</div>

	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(clientsSchema)}
	/>

	<!-- Фоновый градиент -->
	<div
		class="absolute inset-0 bg-linear-to-br from-slate-50 via-white to-blue-50/40 pointer-events-none"
	>
	</div>
	<!-- Декоративные орбы: на мобайле blur-2xl (легче для GPU), на десктопе blur-3xl -->
	<div
		class="absolute -top-32 -left-32 w-80 h-80 bg-primary/5 rounded-full blur-2xl md:blur-3xl pointer-events-none"
	>
	</div>
	<div
		class="absolute -bottom-32 -right-32 w-96 h-96 bg-secondary/5 rounded-full blur-2xl md:blur-3xl pointer-events-none"
	>
	</div>

	<div class="relative container mx-auto px-4 sm:px-6 max-w-7xl">
		<!-- ===== ЗАГОЛОВОК ===== -->
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-5 md:mb-7 reveal-hidden"
		>
			<div>
				<SectionHeading badge="Наши клиенты" id="partners-heading">
					Нам <span class="text-primary">доверяют</span>
				</SectionHeading>
			</div>

			<p class="section-caption">
				Крупнейшие компании России выбирают ANRO TRIP<br />
				для корпоративных поездок и деловых путешествий
			</p>
		</div>

		<!-- ===== ПРЕИМУЩЕСТВА ===== -->
		<div
			class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-14 md:mb-18"
			data-reveal-stagger
		>
			{
				stats.map((stat) => (
					<div
						class="reveal-hidden glass-panel-interactive rounded-2xl p-5 sm:p-6 flex flex-col items-center text-center group
                 max-sm:contain-[layout] max-sm:transition-shadow max-sm:duration-fast max-sm:hover:translate-y-0
                 sm:transition-all justify-center"
					>
						<div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors duration-normal shrink-0">
							<FaIcon name={stat.icon} iconClass="text-xl text-primary" />
						</div>
						<div class="text-sm sm:text-base font-medium text-gray-800 leading-snug">
							{stat.text}
						</div>
					</div>
				))
			}
		</div>

		<!-- ===== ЛЕНТА ЛОГОТИПОВ (декоративная; alt — в sr-only) ===== -->
		<div class="relative md:hidden" aria-hidden="true">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 bg-linear-to-r from-slate-50 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 bg-linear-to-l from-blue-50/60 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				id="partners-mobile-scroll"
				class="flex overflow-x-auto overflow-y-hidden gap-4 pb-4 scrollbar-hide -mx-4 px-4 overscroll-x-contain touch-pan-x touch-pan-y scroll-auto"
			>
				{
					row1.map((partner) => (
						<div class="partners-logo-card shrink-0 w-40 min-h-30 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-4 py-4">
							<div class="flex h-full w-full items-center justify-center overflow-hidden">
								<Image
									src={partner.logo}
									alt=""
									width={partner.logo.width}
									height={partner.logo.height}
									sizes="120px"
									class="partners-logo-img max-h-full max-w-full origin-center object-contain"
									style={logoScaleStyle(partner.logoScale)}
									loading="eager"
									decoding="async"
								/>
							</div>
						</div>
					))
				}
			</div>
		</div>

		<!-- Десктоп: marquee -->
		<div class="reveal-hidden relative hidden md:block" aria-hidden="true">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 sm:w-24 md:w-32 bg-linear-to-r from-white to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 sm:w-24 md:w-32 bg-linear-to-l from-white to-transparent z-10 pointer-events-none"
			>
			</div>
			<div class="partners-marquee-viewport mb-4">
				<div class="partners-track partners-track--forward flex gap-4 w-max">
					{
						row1.map((partner) => (
							<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 md:h-36 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3 group transition-all duration-normal">
								<div class="flex h-full w-full items-center justify-center overflow-hidden">
									<Image
										src={partner.logo}
										alt=""
										class="partners-logo-img max-h-full w-auto max-w-full origin-center object-contain opacity-100 group-hover:opacity-100 transition-opacity duration-normal group-hover:grayscale-0"
										style={logoScaleStyle(partner.logoScale)}
										loading="lazy"
									/>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<!-- ===== CTA ===== -->
		<div class="text-center mt-12 reveal-hidden">
			<a
				href="#contacts"
				class="partners-cta-btn inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-primary text-white font-semibold font-montserrat text-sm hover:bg-primary-dark hover:shadow-lg hover:shadow-primary/30 btn-ripple shadow-[0_4px_20px_rgba(0,171,179,0.35)] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 cursor-pointer"
			>
				Стать клиентом
				<FaIcon
					name="fa6-solid:arrow-right"
					iconClass="text-sm leading-none shrink-0"
				/>
			</a>
		</div>
	</div>
</section>

<script>
	import { initPartnersMarquee } from '../lib/client/partners-marquee.ts';

	initPartnersMarquee();
	document.addEventListener('astro:page-load', initPartnersMarquee);
</script>
