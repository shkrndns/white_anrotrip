---
import { loadBlogCards } from '../lib/blog-cards';
import { siteBlogIndex } from '../lib/site-urls';
import SectionHeading from './ui/SectionHeading.astro';
import FaIcon from './icons/FaIcon.astro';
import BlogTopicCard from './blog/BlogTopicCard.astro';

const cards = (await loadBlogCards()).filter((card) => card.posts.length > 0);
---

<section
	id="journal"
	class="blog-mesh-text-bg relative overflow-hidden py-[50px] border-t border-primary/5"
>
	<div
		class="absolute -top-28 -right-28 size-112 rounded-full bg-primary/8 blur-none md:blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute top-[42%] -left-24 size-80 rounded-full bg-secondary/5 blur-none md:blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute bottom-0 left-1/2 -translate-x-1/2 w-152 h-36 rounded-full bg-primary/4 blur-none md:blur-3xl pointer-events-none"
		aria-hidden="true"
	>
	</div>

	<div class="container relative z-10 mx-auto px-4 sm:px-6 max-w-7xl">
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-3.5 md:mb-5.5 reveal-hidden"
		>
			<div>
				<SectionHeading badge="Блог">
					Наш <span class="text-primary">блог</span>
				</SectionHeading>
			</div>
			<p class="section-caption">
				Новости туризма, путешествия команды ANRO TRIP,<br />
				направления сезона, обзоры отелей и полезные советы<br />
				для ваших счастливых путешествий
			</p>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-5">
			{cards.map((card, index) => <BlogTopicCard card={card} index={index} />)}
		</div>

		<div class="text-center mt-8 reveal-hidden">
			<a
				href={siteBlogIndex()}
				class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-[color,transform] duration-fast group cursor-pointer"
			>
				Все статьи
				<FaIcon
					name="fa6-solid:arrow-right"
					iconClass="text-sm leading-none group-hover:translate-x-1 transition-transform duration-fast"
				/>
			</a>
		</div>
	</div>
</section>

<script>
	import { initBlogSlideshows } from '../lib/client/blog-slideshow';

	document.addEventListener('DOMContentLoaded', () => initBlogSlideshows());
	document.addEventListener('astro:page-load', () => initBlogSlideshows());
</script>
