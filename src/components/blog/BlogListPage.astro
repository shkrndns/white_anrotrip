---
import { Image } from 'astro:assets';
import favicon from '../../assets/favicon.png';
import FooterMinimal from '../FooterMinimal.astro';
import Layout from '../../layouts/Layout.astro';
import type { BlogListContext } from '../../lib/blog-list';
import { siteHomeJournal } from '../../lib/site-urls';
import BlogHero from './BlogHero.astro';
import BlogFeaturedCard from './BlogFeaturedCard.astro';
import BlogPostCard from './BlogPostCard.astro';
import BlogPagination from './BlogPagination.astro';

interface Props extends BlogListContext {
	featuredTitle: string;
	featuredTitleHtml: string;
	featuredDescription: string;
	blogIndexUrl: string;
	pageUrl: string;
	prevUrl?: string;
	nextUrl?: string;
	blogBreadcrumbSchema: Record<string, unknown>;
}

const {
	page,
	featuredPost,
	allDestinations,
	totalCount,
	materialsWord,
	featuredTitle,
	featuredTitleHtml,
	featuredDescription,
	pageUrl,
	prevUrl,
	nextUrl,
	blogBreadcrumbSchema,
} = Astro.props;

const listTitle =
	page.currentPage > 1
		? `Журнал о путешествиях — страница ${page.currentPage} | ANRO TRIP`
		: 'Журнал о путешествиях | ANRO TRIP';
---

<Layout
	title={listTitle}
	description="Вдохновляющие идеи, советы экспертов и путеводители по лучшим направлениям от команды ANRO TRIP."
	canonicalURL={pageUrl}
	showFavorites={false}
	showOfficeWidget={false}
	showScrollToTop={false}
>
	<Fragment slot="head">
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(blogBreadcrumbSchema)}
		/>
		{prevUrl && <link rel="prev" href={prevUrl} />}
		{nextUrl && <link rel="next" href={nextUrl} />}
	</Fragment>

	<main
		id="content"
		class="blog-mesh-text-bg relative overflow-hidden min-h-screen pb-16 md:pb-24"
		aria-label="Журнал о путешествиях"
	>
		<div
			class="absolute -top-28 -right-28 size-112 rounded-full bg-primary/8 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute top-[38%] -left-24 size-80 rounded-full bg-secondary/5 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute bottom-40 -right-16 size-72 rounded-full bg-primary/7 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute bottom-0 left-1/2 -translate-x-1/2 w-152 h-36 rounded-full bg-primary/4 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>

		<BlogHero
			totalCount={totalCount}
			materialsWord={materialsWord}
			allDestinations={allDestinations}
		/>

		<div class="container mx-auto max-w-7xl px-4 pt-2 sm:px-6 md:pt-4">
			<div class="mb-16 grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
				{
					page.currentPage === 1 && featuredPost && (
						<BlogFeaturedCard
							post={featuredPost}
							title={featuredTitle}
							titleHtml={featuredTitleHtml}
							description={featuredDescription}
						/>
					)
				}
				{
					page.data.map((post, index) => (
						<BlogPostCard post={post} index={index} />
					))
				}
			</div>

			<BlogPagination page={page} />
		</div>

		<div class="text-center mt-8 pb-2">
			<a
				href={siteHomeJournal()}
				class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-[color,transform] duration-fast group cursor-pointer"
			>
				<Image
					src={favicon}
					alt=""
					format="png"
					quality="max"
					decoding="async"
					class="h-5 w-5 shrink-0 object-contain transition-transform duration-fast group-hover:-translate-x-1"
				/>
				Наш блог
			</a>
		</div>
	</main>

	<FooterMinimal />
</Layout>

<script>
	const blogCardSlideshowTimers = new WeakMap<
		HTMLElement,
		ReturnType<typeof setInterval>
	>();

	function initCardSlideshows() {
		const slideshows = document.querySelectorAll('[data-slideshow^="card-"]');

		slideshows.forEach((slideshow) => {
			const el = slideshow as HTMLElement;
			const prev = blogCardSlideshowTimers.get(el);
			if (prev !== undefined) {
				clearInterval(prev);
				blogCardSlideshowTimers.delete(el);
			}

			const group = slideshow.getAttribute('data-slideshow');
			if (!group) return;

			const slides = slideshow.querySelectorAll(
				`[data-slideshow-group="${group}"]`,
			);
			if (slides.length < 2) return;

			slides.forEach((slide, i) => {
				(slide as HTMLElement).style.opacity = i === 0 ? '1' : '0';
			});

			let current = 0;
			const intervalMs = 5000;

			const nextSlide = () => {
				const next = (current + 1) % slides.length;
				(slides[current] as HTMLElement).style.opacity = '0';
				(slides[next] as HTMLElement).style.opacity = '1';
				current = next;
			};

			blogCardSlideshowTimers.set(el, setInterval(nextSlide, intervalMs));
		});
	}

	document.addEventListener('DOMContentLoaded', initCardSlideshows);
	document.addEventListener('astro:page-load', initCardSlideshows);
</script>
