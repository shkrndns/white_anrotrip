---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getTourStyleBadge } from '../../lib/tourDestinationBadge';
import { siteBlogPost } from '../../lib/site-urls';
import { formatBlogTitleHtml, typografText } from '../../lib/typograf';

interface Props {
	post: CollectionEntry<'blog'>;
	index: number;
}

const { post, index } = Astro.props;
const cardTitle = typografText(post.data.title);
const cardTitleHtml = formatBlogTitleHtml(post.data.title);
const cardDescription = typografText(post.data.description);
---

<article
	class="group flex flex-col rounded-3xl overflow-hidden bg-white border border-white/10 shadow-[0_4px_24px_rgba(0,171,179,0.15)] hover:shadow-[0_8px_32px_rgba(0,171,179,0.25)] transition-[opacity,transform,box-shadow] duration-slow [content-visibility:auto]"
>
	<a
		href={siteBlogPost(post.id)}
		class="block relative overflow-hidden aspect-4/3"
		aria-label={`Читать статью: ${cardTitle}`}
	>
		{
			post.data.heroImages && post.data.heroImages.length >= 2 ? (
				<div class="absolute inset-0" data-slideshow={`card-${post.id}`}>
					{post.data.heroImages.slice(0, 8).map((img, i) => (
						<div
							class="absolute inset-0 transition-opacity duration-1000 ease-in-out"
							data-slide={i}
							data-slideshow-group={`card-${post.id}`}
						>
							<Image
								src={img}
								alt={`${post.data.title} — фото ${i + 1}`}
								width={600}
								height={450}
								loading={index < 3 ? 'eager' : 'lazy'}
								class="object-cover w-full h-full transition-transform duration-slow ease-out group-hover:scale-[1.04]"
							/>
						</div>
					))}
				</div>
			) : (post.data.heroImages?.[0] ??
			  post.data.cardImage ??
			  post.data.heroImage) ? (
				<Image
					src={
						post.data.heroImages?.[0] ??
						post.data.cardImage ??
						post.data.heroImage!
					}
					alt={post.data.title}
					width={600}
					height={450}
					loading={index < 3 ? 'eager' : 'lazy'}
					class="object-cover w-full h-full transition-transform duration-slow ease-out group-hover:scale-[1.04]"
				/>
			) : (
				<div
					class="blog-card-placeholder w-full h-full"
					role="img"
					aria-label="Место для фото"
				>
					<svg
						class="blog-media-placeholder__icon"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="1.5"
							d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
						/>
					</svg>
					<span class="blog-media-placeholder__label">Фото скоро</span>
				</div>
			)
		}
		{
			post.data.destination && (
				<div class="absolute top-4 left-4">
					<span
						class:list={[
							'inline-block rounded-full px-3 py-1 text-[10px] font-black uppercase tracking-wider',
							getTourStyleBadge(post.data.destination).className,
						]}
					>
						{getTourStyleBadge(post.data.destination).label}
					</span>
				</div>
			)
		}
	</a>
	<div class="relative overflow-hidden p-5 md:p-6 flex flex-col grow">
		{
			index % 3 === 0 && (
				<div
					class="absolute top-0 right-0 size-32 rounded-full bg-primary/8 blur-none md:blur-xl pointer-events-none translate-x-1/4 -translate-y-1/4"
					aria-hidden="true"
				/>
			)
		}
		{
			index % 3 === 0 && (
				<div
					class="absolute bottom-0 left-0 size-20 rounded-full bg-secondary/6 blur-none md:blur-lg pointer-events-none -translate-x-1/3 translate-y-1/3"
					aria-hidden="true"
				/>
			)
		}
		{
			index % 3 === 1 && (
				<div
					class="absolute top-0 left-0 size-28 rounded-full bg-primary/9 blur-none md:blur-xl pointer-events-none -translate-x-1/4 -translate-y-1/4"
					aria-hidden="true"
				/>
			)
		}
		{
			index % 3 === 1 && (
				<div
					class="absolute bottom-0 right-0 size-24 rounded-full bg-primary/7 blur-none md:blur-lg pointer-events-none translate-x-1/3 translate-y-1/3"
					aria-hidden="true"
				/>
			)
		}
		{
			index % 3 === 2 && (
				<div
					class="absolute top-1/2 right-0 size-24 rounded-full bg-secondary/8 blur-none md:blur-xl pointer-events-none translate-x-1/3 -translate-y-1/2"
					aria-hidden="true"
				/>
			)
		}
		{
			index % 3 === 2 && (
				<div
					class="absolute top-0 left-1/3 size-20 rounded-full bg-primary/6 blur-none md:blur-lg pointer-events-none -translate-x-1/2 -translate-y-1/2"
					aria-hidden="true"
				/>
			)
		}
		{
			index % 3 === 2 && (
				<div
					class="absolute bottom-0 left-0 size-20 rounded-full bg-primary/7 blur-none md:blur-lg pointer-events-none -translate-x-1/3 translate-y-1/3"
					aria-hidden="true"
				/>
			)
		}
		<time
			datetime={post.data.pubDate.toISOString()}
			class="text-xs text-gray-500 font-inter mb-2 block"
		>
			{
				post.data.pubDate.toLocaleDateString('ru-RU', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				})
			}
		</time>
		<h2
			class="text-base font-extrabold text-gray-900 mb-2 font-montserrat leading-snug line-clamp-2 group-hover:text-primary transition-colors duration-fast"
		>
			<a href={siteBlogPost(post.id)} set:html={cardTitleHtml} />
		</h2>
		<p
			class="text-sm text-gray-500 line-clamp-2 mb-4 grow font-inter leading-relaxed"
		>
			{cardDescription}
		</p>
		<div
			class="flex items-center justify-between pt-4 border-t border-gray-100"
		>
			<span class="text-xs font-semibold text-gray-500 font-inter"
				>{post.data.author}</span
			>
			<a
				href={siteBlogPost(post.id)}
				class="group/link inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary-dark transition-colors duration-fast font-montserrat uppercase tracking-wide"
				aria-label={`Читать: ${cardTitle}`}
			>
				Читать
				<svg
					class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform duration-fast"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2.5"
						d="M9 5l7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</div>
</article>
