---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { getTourStyleBadge } from '../lib/tourDestinationBadge';
import { siteBlogIndex, siteBlogPost } from '../lib/site-urls';
import { typografText } from '../lib/typograf';
import SectionHeading from './ui/SectionHeading.astro';
import FaIcon from './icons/FaIcon.astro';
import {
	blogCardImageClass,
	isPortraitBlogAspect,
	journalCardAspectClass,
	BLOG_PORTRAIT_IMAGE_HEIGHT,
	BLOG_PORTRAIT_IMAGE_WIDTH,
} from '../lib/blog-media';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredPost = sortedPosts.find((p) => p.data.featured === true);
const latestPosts = sortedPosts
	.filter((p) => (featuredPost ? p.id !== featuredPost.id : true))
	.slice(0, 2);
const displayPosts = featuredPost
	? [featuredPost, ...latestPosts]
	: sortedPosts.slice(0, 3);

const journalBadgeClasses = [
	'bg-red text-white',
	'bg-primary text-white',
	'bg-gray-400 text-white',
	'bg-white text-gray-900 border border-white/70',
];
---

<section
	id="journal"
	class="py-[50px] bg-primary/4 border-t border-primary/5 overflow-hidden"
>
	<div class="container mx-auto px-4 sm:px-6 max-w-7xl">
		<!-- Заголовок секции — паттерн как в PopularTours -->
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-3.5 md:mb-5.5 reveal-hidden"
		>
			<div>
				<SectionHeading badge="Блог">
					Наш <span class="text-primary">блог</span>
				</SectionHeading>
			</div>
			<p class="section-caption">
				Новости туризма, путешествия команды ANRO TRIP,<br />
				направления сезона, обзоры отелей и полезные советы<br />
				для ваших счастливых путешествий
			</p>
		</div>

		<!-- Сетка: три карточки в ряд на lg+ -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
			{
				displayPosts.map((post, index) => {
					const isFeatured = featuredPost?.id === post.id;
					const slideshowKey = `${isFeatured ? 'featured-' : ''}${post.id}-${index}`;
					const cardTitle = typografText(post.data.title);
					const cardDescription = typografText(post.data.description);

					return (
						<article class="group flex flex-col rounded-3xl overflow-hidden bg-white border border-white/10 shadow-[0_4px_24px_rgba(0,171,179,0.15)] hover:shadow-[0_8px_32px_rgba(0,171,179,0.25)] transition-[opacity,transform,box-shadow] duration-slow">
							<a
								href={siteBlogPost(post.id)}
								class:list={[
									'block relative overflow-hidden',
									journalCardAspectClass(post.data.cardAspect),
								]}
								aria-label={`Читать статью: ${cardTitle}`}
							>
								{post.data.heroImages && post.data.heroImages.length >= 2 ? (
									<div
										class="blog-image-frame absolute inset-0 transition-transform duration-slow ease-out group-hover:scale-[1.02]"
										data-slideshow={slideshowKey}
									>
										{post.data.heroImages.slice(0, 8).map((img, i) => (
											<div
												class="absolute inset-0 transition-opacity duration-700 ease-in-out"
												data-slide={i}
												data-slideshow-group={slideshowKey}
											>
												<Image
													src={img}
													alt={`${post.data.title} — фото ${i + 1}`}
													width={600}
													height={
														post.data.cardAspect === '4/5'
															? BLOG_PORTRAIT_IMAGE_HEIGHT
															: 450
													}
													sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
													loading="lazy"
													class={blogCardImageClass(post.data.cardAspect)}
												/>
											</div>
										))}
									</div>
								) : (post.data.cardImage ?? post.data.heroImage) ? (
									<div
										class:list={[
											'absolute inset-0',
											isPortraitBlogAspect(post.data.cardAspect)
												? 'bg-white'
												: 'blog-image-frame',
										]}
									>
										<Image
											src={post.data.cardImage ?? post.data.heroImage!}
											alt={post.data.title}
											width={
												post.data.cardAspect === '4/5'
													? BLOG_PORTRAIT_IMAGE_WIDTH
													: 600
											}
											height={
												post.data.cardAspect === '4/5'
													? BLOG_PORTRAIT_IMAGE_HEIGHT
													: 450
											}
											sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 33vw"
											loading="lazy"
											class:list={[
												blogCardImageClass(post.data.cardAspect),
												post.data.cardAspect === '4/5'
													? ''
													: 'transition-transform duration-slow ease-out group-hover:scale-[1.02]',
											]}
										/>
									</div>
								) : (
									<div
										class="blog-card-placeholder w-full h-full"
										role="img"
										aria-label="Место для фото"
									>
										<svg
											class="blog-media-placeholder__icon"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="1.5"
												d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
											/>
										</svg>
										<span class="blog-media-placeholder__label">
											Фото скоро
										</span>
									</div>
								)}
								<div class="absolute top-4 left-4 flex flex-wrap items-center gap-2">
									{post.data.destination &&
										!isPortraitBlogAspect(post.data.cardAspect) && (
											<span
												class:list={[
													'inline-block rounded-full px-3 py-1 text-[0.625rem] font-black uppercase tracking-wider',
													journalBadgeClasses[
														index % journalBadgeClasses.length
													],
												]}
											>
												{getTourStyleBadge(post.data.destination).label}
											</span>
										)}
								</div>
							</a>

							<div class="p-5 md:p-6 flex flex-col grow">
								<time
									datetime={post.data.pubDate.toISOString()}
									class="text-xs text-gray-500 font-inter mb-2 block"
								>
									{post.data.pubDate.toLocaleDateString('ru-RU', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>

								<h3 class="text-base font-extrabold text-gray-900 mb-2 font-montserrat leading-snug line-clamp-2 group-hover:text-primary transition-colors duration-fast">
									<a href={siteBlogPost(post.id)}>{cardTitle}</a>
								</h3>

								<p class="text-sm text-gray-500 line-clamp-2 mb-4 grow font-inter leading-relaxed">
									{cardDescription}
								</p>

								<div class="flex items-center justify-between pt-4 border-t border-gray-100">
									<span class="text-xs font-semibold text-gray-500 font-inter">
										{post.data.author}
									</span>
									<a
										href={siteBlogPost(post.id)}
										class="group/link inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:text-primary-dark transition-colors duration-fast font-montserrat uppercase tracking-wide"
										aria-label={`Читать: ${cardTitle}`}
									>
										Читать
										<svg
											class="w-3.5 h-3.5 group-hover/link:translate-x-0.5 transition-transform duration-fast"
											fill="none"
											viewBox="0 0 24 24"
											stroke="currentColor"
											aria-hidden="true"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2.5"
												d="M9 5l7 7-7 7"
											/>
										</svg>
									</a>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>

		<!-- CTA под сеткой -->
		<div class="text-center mt-8 reveal-hidden">
			<a
				href={siteBlogIndex()}
				class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-[color,transform] duration-fast group cursor-pointer"
			>
				Все статьи
				<FaIcon
					name="fa6-solid:arrow-right"
					iconClass="text-sm leading-none group-hover:translate-x-1 transition-transform duration-fast"
				/>
			</a>
		</div>
	</div>
</section>

<script>
	/** Сброс предыдущего таймера на контейнере — иначе при VT накапливаются setInterval */
	const journalSlideshowTimers = new WeakMap<
		HTMLElement,
		ReturnType<typeof setInterval>
	>();

	function initSlideshows() {
		const slideshows = document.querySelectorAll('[data-slideshow]');

		slideshows.forEach((container) => {
			const el = container as HTMLElement;
			const prev = journalSlideshowTimers.get(el);
			if (prev !== undefined) {
				clearInterval(prev);
				journalSlideshowTimers.delete(el);
			}

			const group = container.getAttribute('data-slideshow');
			const slides = container.querySelectorAll(
				`[data-slideshow-group="${group}"]`,
			);

			if (slides.length < 2) return;

			slides.forEach((slide, i) => {
				(slide as HTMLElement).style.opacity = i === 0 ? '1' : '0';
			});

			let current = 0;
			const intervalMs = 5000;

			const nextSlide = () => {
				const next = (current + 1) % slides.length;
				(slides[current] as HTMLElement).style.opacity = '0';
				(slides[next] as HTMLElement).style.opacity = '1';
				current = next;
			};

			journalSlideshowTimers.set(el, setInterval(nextSlide, intervalMs));
		});
	}

	document.addEventListener('DOMContentLoaded', initSlideshows);
	document.addEventListener('astro:page-load', initSlideshows);
</script>
