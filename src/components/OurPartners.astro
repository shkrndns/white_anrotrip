---
// src/components/OurPartners.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
	airlinePartners,
	cooperationPartners,
	partnerLogoAlt,
	tourOperatorRow,
} from '../data/our-partners';
import { buildCooperationPartnersSchema } from '../lib/schema-partners';
import { getPublicOrigin } from '../lib/site-urls';
import SectionHeading from './ui/SectionHeading.astro';

type PartnerSlot =
	| {
			type: 'logo';
			name: string;
			logo: ImageMetadata;
			logoScale?: number;
			logoClass?: string;
	  }
	| { type: 'placeholder'; name: string };

const partnerLogoClass = (logoClass?: string) =>
	logoClass
		? `origin-center object-contain ${logoClass}`
		: 'max-h-full max-w-full origin-center object-contain';

const logoScaleStyle = (scale?: number) =>
	scale ? `transform: scale(${scale})` : undefined;

const baseUrl = getPublicOrigin(
	Astro.request,
	Astro.url.origin,
	Astro.site?.origin,
);
const partnersSchema = buildCooperationPartnersSchema(
	baseUrl,
	cooperationPartners,
);

// Верхний ряд: 10 авиакомпаний по порядку (1…10)
const row1Slots: PartnerSlot[] = airlinePartners.map((partner) => ({
	type: 'logo' as const,
	name: partner.name,
	logo: partner.logo,
	logoScale: partner.logoScale,
	logoClass: partner.logoClass,
}));

// Нижний ряд: 12 туроператоров по слотам 1…12
const row2Slots: PartnerSlot[] = tourOperatorRow.map((partner) => ({
	type: 'logo' as const,
	name: partner.name,
	logo: partner.logo,
	logoScale: partner.logoScale,
	logoClass: partner.logoClass,
}));

const row1 = [...row1Slots, ...row1Slots];
const row2 = [...row2Slots, ...row2Slots].reverse();

interface Props {
	class?: string;
}
const { class: classes = '' }: Props = Astro.props;
---

<section
	id="our-partners"
	class={`relative py-[50px] bg-primary/4 overflow-hidden ${classes}`}
	aria-labelledby="our-partners-heading"
>
	<!-- SEO: один канонический индекс партнёров (без дублей marquee) -->
	<div class="sr-only">
		<h3 id="our-partners-index">Партнёры ANRO TRIP</h3>
		<ul>
			{
				cooperationPartners.map((partner) => (
					<li>
						<Image
							src={partner.logo}
							alt={partnerLogoAlt(partner)}
							width={partner.logo.width}
							height={partner.logo.height}
							loading="lazy"
							decoding="async"
						/>
					</li>
				))
			}
		</ul>
	</div>

	<script
		type="application/ld+json"
		set:html={JSON.stringify(partnersSchema)}
	/>

	<!-- Декоративные фоновые элементы -->
	<div
		class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl pointer-events-none -translate-y-1/2 translate-x-1/3"
	>
	</div>
	<div
		class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-secondary/5 rounded-full blur-3xl pointer-events-none translate-y-1/3 -translate-x-1/4"
	>
	</div>

	<div class="relative container mx-auto px-4 sm:px-6 max-w-7xl">
		<!-- ЗАГОЛОВОК -->
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-4 md:mb-6 reveal-hidden"
		>
			<div>
				<SectionHeading badge="Наши партнёры" id="our-partners-heading">
					<span class="text-primary">Сотрудничество</span>
				</SectionHeading>
			</div>

			<p class="section-caption md:translate-x-6">
				Мы сотрудничаем с ведущими авиакомпаниями, отельными сетями и
				туроператорами по всему миру, чтобы предоставлять вам лучший сервис
			</p>
		</div>

		<!-- ЛЕНТА ЛОГОТИПОВ (декоративная; alt — в sr-only индексе выше) -->

		<!-- Мобилка: только ручной скролл (как в Partners.astro — «Наши клиенты») -->
		<div class="relative md:hidden" aria-hidden="true">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 bg-linear-to-r from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 bg-linear-to-l from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>

			<div
				id="our-partners-mobile-scroll-1"
				class="flex overflow-x-auto overflow-y-hidden gap-4 pb-4 mb-4 scrollbar-hide -mx-4 px-4 overscroll-x-contain touch-pan-x touch-pan-y scroll-auto"
			>
				{
					row1.map((partner) => (
						<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-4 py-3">
							{partner.type === 'logo' ? (
								<div class="flex h-full w-full items-center justify-center overflow-hidden">
									<Image
										src={partner.logo}
										alt=""
										width={partner.logo.width}
										height={partner.logo.height}
										sizes="120px"
										class={`partners-logo-img ${partnerLogoClass(partner.logoClass)}`}
										style={logoScaleStyle(partner.logoScale)}
										loading="lazy"
										decoding="async"
									/>
								</div>
							) : (
								<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider text-center">
									{partner.name}
								</span>
							)}
						</div>
					))
				}
			</div>

			<div
				id="our-partners-mobile-scroll-2"
				class="flex overflow-x-auto overflow-y-hidden gap-4 pb-4 scrollbar-hide -mx-4 px-4 overscroll-x-contain touch-pan-x touch-pan-y scroll-auto"
			>
				{
					row2.map((partner) => (
						<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-4 py-3">
							{partner.type === 'logo' ? (
								<div class="flex h-full w-full items-center justify-center overflow-hidden">
									<Image
										src={partner.logo}
										alt=""
										width={partner.logo.width}
										height={partner.logo.height}
										sizes="120px"
										class={`partners-logo-img ${partnerLogoClass(partner.logoClass)}`}
										style={logoScaleStyle(partner.logoScale)}
										loading="lazy"
										decoding="async"
									/>
								</div>
							) : (
								<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider text-center">
									{partner.name}
								</span>
							)}
						</div>
					))
				}
			</div>
		</div>

		<!-- Десктоп: marquee -->
		<div class="reveal-hidden relative hidden md:block" aria-hidden="true">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 sm:w-32 bg-linear-to-r from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 sm:w-32 bg-linear-to-l from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>

			<div class="partners-marquee-viewport mb-4">
				<div class="partners-track partners-track--forward flex gap-4 w-max">
					{
						row1.map((partner) => (
							<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 md:h-36 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3 group transition-all duration-normal">
								{partner.type === 'logo' ? (
									<div class="flex h-full w-full items-center justify-center overflow-hidden">
										<Image
											src={partner.logo}
											alt=""
											width={partner.logo.width}
											height={partner.logo.height}
											sizes="120px"
											class={`partners-logo-img ${partnerLogoClass(partner.logoClass)}`}
											style={logoScaleStyle(partner.logoScale)}
											loading="lazy"
											decoding="async"
										/>
									</div>
								) : (
									<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider group-hover:text-primary/50 transition-colors text-center">
										{partner.name}
									</span>
								)}
							</div>
						))
					}
				</div>
			</div>

			<div class="partners-marquee-viewport">
				<div class="partners-track partners-track--reverse flex gap-4 w-max">
					{
						row2.map((partner) => (
							<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 md:h-36 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3 group transition-all duration-normal">
								{partner.type === 'logo' ? (
									<div class="flex h-full w-full items-center justify-center overflow-hidden">
										<Image
											src={partner.logo}
											alt=""
											width={partner.logo.width}
											height={partner.logo.height}
											sizes="120px"
											class={`partners-logo-img ${partnerLogoClass(partner.logoClass)}`}
											style={logoScaleStyle(partner.logoScale)}
											loading="lazy"
											decoding="async"
										/>
									</div>
								) : (
									<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider group-hover:text-primary/50 transition-colors text-center">
										{partner.name}
									</span>
								)}
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initOurPartnersMarquee } from '../lib/client/partners-marquee.ts';

	initOurPartnersMarquee();
	document.addEventListener('astro:page-load', initOurPartnersMarquee);
</script>
