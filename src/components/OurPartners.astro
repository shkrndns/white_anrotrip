---
// src/components/OurPartners.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tourOperatorPartners } from '../data/our-partners';
import SectionHeading from './ui/SectionHeading.astro';

type PartnerSlot =
	| { type: 'logo'; name: string; logo: ImageMetadata }
	| { type: 'placeholder'; name: string };

const placeholders: PartnerSlot[] = Array.from({ length: 10 }).map((_, i) => ({
	type: 'placeholder',
	name: `Партнёр ${i + 1}`,
}));

// Пробная тройка: 2 логотипа в верхнем ряду, 1 — в нижнем
const row1Slots: PartnerSlot[] = [
	{
		type: 'logo',
		name: tourOperatorPartners[0].name,
		logo: tourOperatorPartners[0].logo,
	},
	{
		type: 'logo',
		name: tourOperatorPartners[1].name,
		logo: tourOperatorPartners[1].logo,
	},
	...placeholders.slice(2),
];

const row2Slots: PartnerSlot[] = [
	{
		type: 'logo',
		name: tourOperatorPartners[2].name,
		logo: tourOperatorPartners[2].logo,
	},
	...placeholders.slice(1),
];

const row1 = [...row1Slots, ...row1Slots];
const row2 = [...row2Slots, ...row2Slots].reverse();

interface Props {
	class?: string;
}
const { class: classes = '' }: Props = Astro.props;
---

<section
	id="our-partners"
	class={`relative py-[50px] bg-primary/4 overflow-hidden ${classes}`}
>
	<!-- Декоративные фоновые элементы -->
	<div
		class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl pointer-events-none -translate-y-1/2 translate-x-1/3"
	>
	</div>
	<div
		class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-secondary/5 rounded-full blur-3xl pointer-events-none translate-y-1/3 -translate-x-1/4"
	>
	</div>

	<div class="relative container mx-auto px-4 sm:px-6 max-w-7xl">
		<!-- ЗАГОЛОВОК -->
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-4 md:mb-6 reveal-hidden"
		>
			<div>
				<SectionHeading badge="Наши партнёры">
					<span class="text-primary">Сотрудничество</span>
				</SectionHeading>
			</div>

			<p class="section-caption">
				Мы сотрудничаем с ведущими авиакомпаниями, отельными сетями и
				туроператорами по всему миру, чтобы предоставлять вам лучший сервис
			</p>
		</div>

		<!-- ЛЕНТА ЛОГОТИПОВ -->

		<!-- Мобилка: только ручной скролл (как в Partners.astro — «Наши клиенты») -->
		<div class="relative md:hidden">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 bg-linear-to-r from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 bg-linear-to-l from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>

			<div
				id="our-partners-mobile-scroll-1"
				class="flex overflow-x-auto overflow-y-hidden gap-4 pb-4 mb-4 scrollbar-hide -mx-4 px-4 overscroll-x-contain touch-pan-x touch-pan-y scroll-auto"
			>
				{
					row1.map((partner) => (
						<div class="shrink-0 w-40 h-22 sm:w-44 sm:h-24 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3">
							{partner.type === 'logo' ? (
								<Image
									src={partner.logo}
									alt={partner.name}
									width={160}
									height={120}
									class="max-h-full w-auto max-w-full object-contain"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider text-center">
									{partner.name}
								</span>
							)}
						</div>
					))
				}
			</div>

			<div
				id="our-partners-mobile-scroll-2"
				class="flex overflow-x-auto overflow-y-hidden gap-4 pb-4 scrollbar-hide -mx-4 px-4 overscroll-x-contain touch-pan-x touch-pan-y scroll-auto"
			>
				{
					row2.map((partner) => (
						<div class="shrink-0 w-40 h-22 sm:w-44 sm:h-24 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3">
							{partner.type === 'logo' ? (
								<Image
									src={partner.logo}
									alt={partner.name}
									width={160}
									height={120}
									class="max-h-full w-auto max-w-full object-contain"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider text-center">
									{partner.name}
								</span>
							)}
						</div>
					))
				}
			</div>
		</div>

		<!-- Десктоп: marquee -->
		<div class="reveal-hidden relative hidden md:block">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 sm:w-32 bg-linear-to-r from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 sm:w-32 bg-linear-to-l from-primary/4 to-transparent z-10 pointer-events-none"
			>
			</div>

			<div class="partners-marquee-viewport mb-4">
				<div
					class="partners-track partners-track--forward flex gap-4 w-max"
					aria-hidden="true"
				>
					{
						row1.map((partner) => (
							<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 md:h-36 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3 group transition-all duration-normal">
								{partner.type === 'logo' ? (
									<Image
										src={partner.logo}
										alt={partner.name}
										class="max-h-full w-auto max-w-full object-contain"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider group-hover:text-primary/50 transition-colors text-center">
										{partner.name}
									</span>
								)}
							</div>
						))
					}
				</div>
			</div>

			<div class="partners-marquee-viewport">
				<div
					class="partners-track partners-track--reverse flex gap-4 w-max"
					aria-hidden="true"
				>
					{
						row2.map((partner) => (
							<div class="partners-logo-card shrink-0 w-40 h-22 sm:w-44 sm:h-24 md:h-36 rounded-2xl bg-white border border-gray-100 flex items-center justify-center px-5 py-3 group transition-all duration-normal">
								{partner.type === 'logo' ? (
									<Image
										src={partner.logo}
										alt={partner.name}
										class="max-h-full w-auto max-w-full object-contain"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="text-gray-300 font-montserrat font-bold text-xs sm:text-sm uppercase tracking-wider group-hover:text-primary/50 transition-colors text-center">
										{partner.name}
									</span>
								)}
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { initOurPartnersMarquee } from '../lib/client/partners-marquee.ts';

	initOurPartnersMarquee();
	document.addEventListener('astro:page-load', initOurPartnersMarquee);
</script>
