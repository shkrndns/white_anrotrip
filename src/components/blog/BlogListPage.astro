---
import { Image } from 'astro:assets';
import favicon from '../../assets/favicon.png';
import FooterMinimal from '../FooterMinimal.astro';
import Layout from '../../layouts/Layout.astro';
import type { BlogCardWithPosts } from '../../lib/blog-cards';
import { siteHome, siteHomeJournal } from '../../lib/site-urls';
import FaIcon from '../icons/FaIcon.astro';
import BlogHero from './BlogHero.astro';
import BlogTopicCard from './BlogTopicCard.astro';

interface Props {
	cards: BlogCardWithPosts[];
	allDestinations: string[];
	totalCount: number;
	materialsWord: string;
	blogIndexUrl: string;
	pageUrl: string;
	blogBreadcrumbSchema: Record<string, unknown>;
}

const {
	cards,
	allDestinations,
	totalCount,
	materialsWord,
	pageUrl,
	blogBreadcrumbSchema,
} = Astro.props;
---

<Layout
	title="Журнал о путешествиях | ANRO TRIP"
	description="Вдохновляющие идеи, советы экспертов и путеводители по лучшим направлениям от команды ANRO TRIP."
	canonicalURL={pageUrl}
	showFavorites={false}
	showOfficeWidget={false}
	showScrollToTop={false}
>
	<Fragment slot="head">
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(blogBreadcrumbSchema)}
		/>
	</Fragment>

	<main
		id="content"
		class="blog-mesh-text-bg relative overflow-hidden min-h-screen pb-16 md:pb-24"
		aria-label="Журнал о путешествиях"
	>
		<div
			class="absolute -top-28 -right-28 size-112 rounded-full bg-primary/8 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute top-[38%] -left-24 size-80 rounded-full bg-secondary/5 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute bottom-40 -right-16 size-72 rounded-full bg-primary/7 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute bottom-0 left-1/2 -translate-x-1/2 w-152 h-36 rounded-full bg-primary/4 blur-none md:blur-3xl pointer-events-none"
			aria-hidden="true"
		>
		</div>

		<div class="container mx-auto max-w-7xl px-4 sm:px-6">
			<nav class="flex items-center gap-1.5 pt-6 pb-2" aria-label="Навигация">
				<a
					href={siteHome()}
					class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium text-gray-500 hover:text-primary hover:bg-primary/5 transition-all duration-200 font-inter"
				>
					<FaIcon
						fa="fa-solid fa-house"
						iconClass="text-sm leading-none shrink-0 -translate-y-0.5"
					/>
					Главная
				</a>
				<FaIcon
					fa="fa-solid fa-chevron-right"
					iconClass="text-xs text-gray-400 shrink-0"
				/>
				<span
					class="px-2.5 py-1 rounded-full text-xs font-semibold text-gray-600 bg-gray-100/80 font-inter"
					>Журнал</span
				>
			</nav>
		</div>

		<BlogHero
			totalCount={totalCount}
			materialsWord={materialsWord}
			allDestinations={allDestinations}
		/>

		<div class="container mx-auto max-w-7xl px-4 pt-2 sm:px-6 md:pt-4">
			<div
				class="mb-16 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-5"
			>
				{
					cards.map((card, index) => (
						<BlogTopicCard card={card} index={index} />
					))
				}
			</div>
		</div>

		<div class="text-center mt-8 pb-2">
			<a
				href={siteHomeJournal()}
				class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary transition-[color,transform] duration-fast group cursor-pointer"
			>
				<Image
					src={favicon}
					alt=""
					format="png"
					quality="max"
					decoding="async"
					class="h-5 w-5 shrink-0 object-contain transition-transform duration-fast group-hover:-translate-x-1"
				/>
				Наш блог
			</a>
		</div>
	</main>

	<FooterMinimal />
</Layout>

<script>
	import { initBlogSlideshows } from '../../lib/client/blog-slideshow';

	document.addEventListener('DOMContentLoaded', () => initBlogSlideshows());
	document.addEventListener('astro:page-load', () => initBlogSlideshows());
</script>
