{
	"name": "white_anrotrip",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=22.23.0 <23",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"dev": "astro dev",
		"check": "astro check",
		"lint": "oxlint src && eslint \"src/**/*.{astro,ts,js,mjs}\"",
		"format": "prettier --write .",
		"format:check": "prettier --check \"**/*.{ts,js,mjs,cjs,json,yml,yaml,css,md}\"",
		"spellcheck": "cspell -c cspell.config.yaml \"src/**/*.astro\" \"src/**/*.md\"",
		"test:e2e": "playwright test",
		"lhci": "lhci autorun",
		"prepare": "lefthook install",
		"build": "astro build",
		"prebuild": "pnpm optimize:images",
		"optimize:images": "node scripts/optimize-images.mjs",
		"import:max-blog": "node scripts/import-max-blog.mjs",
		"typograf:blog": "node scripts/typograf-blog.mjs",
		"skills:install": "node scripts/install-agent-skills.mjs",
		"rc:awake": "./scripts/cursor-remote-control-awake.sh",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.4",
		"@astrojs/node": "^11.1.4",
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/montserrat": "^5.2.8",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "^7.2.9",
		"astro-iconify": "^1.3.1",
		"nodemailer": "^9.1.1",
		"sharp": "^0.35.4",
		"tailwindcss": "^4.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@cspell/dict-ru_ru": "^2.3.2",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@types/nodemailer": "^8.0.1",
		"cspell": "^9.8.0",
		"eslint": "^10.10.0",
		"eslint-plugin-astro": "^3.1.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"globals": "^17.12.0",
		"hast-util-from-html": "^2.0.3",
		"lefthook": "^2.1.12",
		"oxlint": "^1.81.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"typograf": "^7.7.0",
		"unist-util-visit": "^5.1.0"
	}
