---
// src/components/GiftSection.astro
import { Image } from 'astro:assets';
import certifImg from '../assets/certif/certif.webp';
import SectionHeading from './ui/SectionHeading.astro';
---

<section
	id="gift"
	class="relative py-[50px] bg-gray-950 text-white overflow-hidden scroll-mt-[calc(var(--site-header-h,5rem)-30px)]"
>
	<!-- Декоративные орбы -->
	<div
		class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/6 rounded-full blur-none md:blur-3xl pointer-events-none translate-x-1/3 -translate-y-1/3"
	>
	</div>
	<div
		class="absolute bottom-0 left-0 w-80 h-80 bg-primary/8 rounded-full blur-none md:blur-3xl pointer-events-none -translate-x-1/3 translate-y-1/3"
	>
	</div>
	<!-- Сеточный фон -->
	<div
		class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-size-[60px_60px] pointer-events-none"
	>
	</div>

	<div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
			<!-- Левая часть: текст -->
			<div class="reveal-hidden">
				<SectionHeading
					badge="Подарочный сертификат"
					variant="icon"
					headingClass="section-heading-plus font-montserrat font-extrabold uppercase tracking-tight mb-4 md:mb-6"
				>
					<svg
						slot="icon"
						class="section-badge__icon"
						fill="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path
							d="M20 12V22H4V12M22 7H2V12H22V7ZM12 22V7M12 7H7.5C6.12 7 5 5.88 5 4.5S6.12 2 7.5 2C9.47 2 12 4 12 4M12 7H16.5C17.88 7 19 5.88 19 4.5S17.88 2 16.5 2C14.53 2 12 4 12 4"
						></path>
					</svg>
					Лучший<br />подарок —<br />
					<span class="text-primary">путешествие</span>
				</SectionHeading>

				<p class="text-white/60 text-lg leading-relaxed mb-8 max-w-md">
					Подарите близким эмоции, которые останутся с ними навсегда. Сертификат
					готовится индивидуально под ваши пожелания — на сумму, на определённую
					услугу или уже забронированные авиабилеты, тур, отель:
				</p>

				<!-- Фичи -->
				<div class="space-y-3 mb-10">
					{
						[
							'Оформление за 15 минут',
							'Доставка на email',
							'Печатный вариант подготовим по договорённости',
						].map((f) => (
							<div class="flex items-center gap-3">
								<div class="w-5 h-5 rounded-full bg-primary/15 flex items-center justify-center shrink-0">
									<svg
										class="w-3 h-3 text-primary"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M5 13l4 4L19 7"
										/>
									</svg>
								</div>
								<span class="text-white/70 text-sm">{f}</span>
							</div>
						))
					}
				</div>

				<button
					onclick="openGiftModal()"
					type="button"
					class="group relative inline-flex items-center justify-center gap-3 overflow-hidden rounded-full bg-red px-8 py-4 font-black text-white shadow-[0_4px_14px_4px_color-mix(in_srgb,var(--color-red)_30%,transparent)] hover:bg-red-hover hover:shadow-[0_6px_18px_4px_color-mix(in_srgb,var(--color-red)_40%,transparent)] transition-[background-color,box-shadow] duration-normal btn-ripple cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 text-sm uppercase tracking-wider"
				>
					<!-- Shine sweep -->
					<span
						class="absolute inset-0 w-[200%] bg-linear-to-r from-transparent via-white/35 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-slow ease-out pointer-events-none"
					></span>
					<svg
						class="w-5 h-5 shrink-0 relative z-10"
						fill="none"
						stroke="currentColor"
						stroke-width="2.5"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M20 12V22H4V12M22 7H2V12H22V7ZM12 22V7M12 7H7.5C6.12 7 5 5.88 5 4.5S6.12 2 7.5 2C9.47 2 12 4 12 4M12 7H16.5C17.88 7 19 5.88 19 4.5S17.88 2 16.5 2C14.53 2 12 4 12 4"
						></path>
					</svg>
					<span class="relative z-10">Приобрести сертификат</span>
				</button>
			</div>

			<!-- Правая часть: карта сертификата -->
			<button
				type="button"
				class="reveal-hidden flex items-center justify-center cursor-pointer border-0 bg-transparent p-0 text-left"
				onclick="openGiftModal()"
			>
				<div class="relative w-full max-w-[528px] cursor-pointer group">
					<!-- Тень/свечение -->
					<div
						class="absolute -inset-4 bg-primary/30 rounded-3xl blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-slow pointer-events-none"
					>
					</div>

					<!-- Карта: в покое сжата с крупного слоя, при hover — scale(1), без растягивания пикселей -->
					<div
						class="relative origin-center rounded-2xl overflow-hidden shadow-2xl transition-transform duration-slow scale-[0.909] [@media(hover:hover)]:group-hover:scale-100 [@media(hover:hover)]:group-hover:-rotate-3 motion-reduce:group-hover:scale-[0.909] motion-reduce:group-hover:rotate-0"
					>
						<Image
							src={certifImg}
							alt="Подарочный сертификат ANRO TRIP"
							quality="max"
							class="w-full h-auto object-cover"
							loading="lazy"
						/>
						<!-- Shine sweep -->
						<div
							class="absolute inset-0 bg-linear-to-tr from-transparent via-white/60 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-slow ease-in-out pointer-events-none"
						>
						</div>
					</div>

					<!-- Тень под картой -->
					<div
						class="absolute -bottom-4 left-8 right-8 h-6 bg-primary/20 blur-xl rounded-full pointer-events-none"
					>
					</div>
				</div>
			</button>
		</div>
	</div>
</section>
