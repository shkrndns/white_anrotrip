---
// src/components/About.astro
import AboutHero from './about/AboutHero.astro';
import AboutBenefitsGrid from './about/AboutBenefitsGrid.astro';
import AboutDirections from './about/AboutDirections.astro';
import AboutServicesGrid from './about/AboutServicesGrid.astro';
import AboutCta from './about/AboutCta.astro';

export interface Props {
	class?: string;
}
const { class: classes = '' } = Astro.props;
---

<section id="about" class={`relative overflow-hidden bg-white ${classes}`}>
	<AboutHero />
	<AboutBenefitsGrid />
	<AboutDirections />
	<AboutServicesGrid />
	<AboutCta />
</section>
