---
import { getImage } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BlogCardFeed from '../../components/blog/BlogCardFeed.astro';
import BlogArticleBlock from '../../components/blog/BlogArticleBlock.astro';
import { loadBlogCard } from '../../lib/blog-cards';
import { isBlogCardId } from '../../data/blog-cards';
import { buildBlogCardSchemaGraph } from '../../lib/schema-blog';
import {
	siteBlogCard,
	siteBlogCardPost,
	siteBlogIndex,
} from '../../lib/site-urls';
import { typografText } from '../../lib/typograf';

const slug = Astro.params.slug;
if (!slug) {
	return Astro.redirect(siteBlogIndex());
}

if (!isBlogCardId(slug)) {
	const post = await getEntry('blog', slug);
	if (post && !post.data.draft && post.data.card) {
		return Astro.redirect(siteBlogCardPost(post.data.card, post.id), 301);
	}
	if (slug === 'travel-digest-september-2026') {
		return Astro.redirect(siteBlogCard('september-start'), 301);
	}
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const card = await loadBlogCard(slug);
if (!card) {
	return new Response(null, { status: 404, statusText: 'Not Found' });
}

const siteOrigin = Astro.site?.href.replace(/\/$/, '') ?? Astro.url.origin;
const articles = await Promise.all(
	card.posts.map(async (post) => {
		const { Content } = await render(post);
		return {
			post,
			Content,
			displayTitle: typografText(post.data.title),
			displayDescription: typografText(post.data.description),
		};
	}),
);

const cardUrl = new URL(siteBlogCard(card.id), `${siteOrigin}/`).href;
const blogIndexUrl = new URL(siteBlogIndex(), `${siteOrigin}/`).href;
let ogImage = new URL('/og-image.png', `${siteOrigin}/`).href;
const cover = card.images[0];
if (cover) {
	const optimized = await getImage({
		src: cover,
		width: 1200,
		height: 630,
		quality: 85,
	});
	ogImage = new URL(optimized.src, `${siteOrigin}/`).href;
}

const postingInputs = await Promise.all(
	articles.map(async (article) => {
		let imageUrl = ogImage;
		const hero = article.post.data.heroImage;
		if (hero) {
			const optimized = await getImage({
				src: hero,
				width: 1200,
				height: 630,
				quality: 85,
			});
			imageUrl = new URL(optimized.src, `${siteOrigin}/`).href;
		}

		return {
			baseUrl: `${siteOrigin}/`,
			postUrl: new URL(
				siteBlogCardPost(card.id, article.post.id),
				`${siteOrigin}/`,
			).href,
			headline: article.displayTitle,
			description: article.displayDescription,
			datePublished: article.post.data.pubDate,
			dateModified: article.post.data.updatedDate,
			authorName: article.post.data.author,
			imageUrl,
		};
	}),
);

const schemaGraph = buildBlogCardSchemaGraph({
	baseUrl: `${siteOrigin}/`,
	cardTitle: card.title,
	cardUrl,
	blogIndexUrl,
	articles: postingInputs,
});

const publishedMs = card.posts.map((post) => post.data.pubDate.getTime());
const modifiedMs = card.posts.map((post) =>
	(post.data.updatedDate ?? post.data.pubDate).getTime(),
);
const articlePublishedTime = new Date(Math.min(...publishedMs)).toISOString();
const articleModifiedTime = new Date(Math.max(...modifiedMs)).toISOString();
---

<BlogCardFeed
	card={card}
	navItems={articles.map((article) => ({
		id: article.post.id,
		title: article.displayTitle,
	}))}
	canonicalURL={cardUrl}
	ogImage={ogImage}
	schemaGraph={schemaGraph}
	ogType="article"
	articlePublishedTime={articlePublishedTime}
	articleModifiedTime={articleModifiedTime}
>
	{
		articles.map((article) => {
			const { Content } = article;
			return (
				<BlogArticleBlock
					post={article.post}
					displayTitle={article.displayTitle}
					displayDescription={article.displayDescription}
				>
					<Content />
				</BlogArticleBlock>
			);
		})
	}
</BlogCardFeed>
