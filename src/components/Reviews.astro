---
// src/components/Reviews.astro
import { Image } from 'astro:assets';
import ExternalReviewsRow from './widgets/ExternalReviewsRow.astro';
import SectionHeading from './ui/SectionHeading.astro';
import ReviewsLightbox from './reviews/ReviewsLightbox.astro';
import ReviewFormOverlay from './reviews/ReviewFormOverlay.astro';
import {
	twoGisRating,
	twoGisReviews,
	twoGisReviewsUrl,
	yandexRating,
	yandexReviews,
	yandexReviewsUrl,
} from '../lib/external-reviews';
import { buildReviewPlatformsSchema } from '../lib/schema-reviews';
import { reviewDocs as reviews } from '../data/review-docs';

const reviewPlatformsSchema = buildReviewPlatformsSchema();
---

<section id="reviews" class="relative py-[50px] overflow-hidden bg-gray-950">
	<script
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(reviewPlatformsSchema)}
	/>
	<div
		class="absolute -top-40 -left-40 w-96 h-96 bg-primary/10 rounded-full blur-none md:blur-3xl pointer-events-none"
	>
	</div>
	<div
		class="absolute -bottom-40 -right-40 w-80 h-80 bg-secondary/8 rounded-full blur-none md:blur-3xl pointer-events-none"
	>
	</div>
	<div
		class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[60px_60px] pointer-events-none"
	>
	</div>

	<div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6 md:mb-8 reveal-hidden"
		>
			<div>
				<SectionHeading
					badge="Отзывы"
					headingClass="section-heading-plus font-montserrat font-extrabold text-white uppercase tracking-tight"
				>
					Что говорят<br />
					<span class="text-primary">наши клиенты</span>
				</SectionHeading>
			</div>
		</div>

		<div class="relative reveal-hidden">
			<div
				class="absolute left-0 top-0 bottom-0 w-16 bg-linear-to-r from-gray-950 to-transparent z-10 pointer-events-none"
			>
			</div>
			<div
				class="absolute right-0 top-0 bottom-0 w-16 bg-linear-to-l from-gray-950 to-transparent z-10 pointer-events-none"
			>
			</div>

			<div
				class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory scrollbar-hide -mx-4 sm:-mx-6 px-4 sm:px-6 md:mx-0 md:px-0 overscroll-x-contain max-sm:overscroll-y-auto scroll-smooth [touch-action:pan-x_pan-y]"
				id="reviews-scroller"
			>
				{
					reviews.map((item, index) => (
						<button
							type="button"
							class="snap-start shrink-0 w-32 sm:w-36 group cursor-pointer border-0 bg-transparent p-0 text-left"
							data-review-index={index}
							aria-label={`Открыть отзыв: ${item.title}`}
						>
							<div class="reviews-doc-card relative bg-white rounded-xl overflow-hidden shadow-lg border border-white/10">
								<Image
									src={item.image}
									alt={item.title}
									width={144}
									height={203}
									class="w-full h-auto object-cover aspect-[1/1.41] pointer-events-none"
									loading="lazy"
									sizes="(max-width: 640px) 128px, 144px"
									fetchpriority={index < 2 ? undefined : 'low'}
								/>
								<div class="absolute inset-0 bg-primary/0 group-hover:bg-primary/10 transition-colors duration-normal flex items-center justify-center">
									<div class="w-10 h-10 rounded-full bg-white/90 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-normal shadow-[0_4px_12px_rgba(0,0,0,0.15)]">
										<svg
											class="w-5 h-5 text-primary"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<>
												<circle cx="11" cy="11" r="8" />
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													d="M21 21l-4.35-4.35M11 8v6M8 11h6"
												/>
											</>
										</svg>
									</div>
								</div>
							</div>
							<p
								class="text-center text-[11px] text-white/70 mt-2 truncate px-1"
								title={item.title}
							>
								{item.title}
							</p>
						</button>
					))
				}
			</div>
		</div>

		<div class="mt-10 md:mt-12 space-y-8">
			<ExternalReviewsRow
				theme="light"
				platform="yandex"
				score={yandexRating.score}
				ratingsCount={yandexRating.ratingsCount}
				reviewsCount={yandexRating.reviewsCount}
				link={yandexReviewsUrl}
				platformLabel="Карты"
				sourceLabel="Отзыв Яндекс Карты"
				reviews={yandexReviews}
				scrollerId="yandex-reviews-scroller"
			/>

			<ExternalReviewsRow
				theme="dark"
				platform="2gis"
				score={twoGisRating.score}
				ratingsCount={twoGisRating.ratingsCount}
				reviewsCount={twoGisRating.reviewsCount}
				link={twoGisReviewsUrl}
				platformLabel="2ГИС"
				sourceLabel="Отзыв 2ГИС"
				reviews={twoGisReviews}
				readMoreCaps
				scrollerId="twogis-reviews-scroller"
			/>
		</div>

		<div class="text-center mt-10 reveal-hidden">
			<button
				id="open-review-form"
				type="button"
				class="reviews-cta-btn inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-white/10 border border-primary/15 text-white font-bold text-sm uppercase tracking-wider shadow-[0_4px_12px_rgba(0,171,179,0.25)] hover:bg-primary/15 hover:shadow-lg hover:shadow-primary/30 btn-ripple cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-gray-950"
			>
				<svg
					class="w-4 h-4 text-primary"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
					></path>
				</svg>
				Оставить отзыв
			</button>
		</div>
	</div>

	<ReviewsLightbox reviews={reviews} />
	<ReviewFormOverlay />
</section>

<script>
	import { initReviewsScroller } from '../lib/client/reviews-lightbox.ts';

	initReviewsScroller();
	document.addEventListener('astro:page-load', initReviewsScroller);
	window.addEventListener('load', initReviewsScroller);
</script>
