---
import '../styles/global.css';
import favicon from '../assets/favicon.png';
import { ClientRouter } from 'astro:transitions';
import ScrollProgress from '../components/ScrollProgress.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CallbackModal from '../components/CallbackModal.astro';
import FavoritesWidget from '../components/FavoritesWidget.astro';
import CookieBanner from '../components/CookieBanner.astro';
import OfficeWidget from '../components/OfficeWidget.astro';
import GiftModal from '../components/GiftModal.astro';
import { getPublicOrigin, resolveOgImageUrl, siteHome } from '../lib/site-urls';
import { company, companySameAs } from '../data/company';
import {
	buildAggregateRatingSchema,
	twoGisReviewsUrl,
	yandexReviewsUrl,
} from '../lib/external-reviews';

interface Props {
	title: string;
	description?: string;
	/** Полный URL страницы для canonical и og:url (если не задан — берётся из Astro.url) */
	canonicalURL?: string;
	/** Путь или URL картинки для превью в соцсетях (1200×630, логотип). По умолчанию /og-image.jpg */
	ogImage?: string;
	showFavorites?: boolean;
	showScrollProgress?: boolean;
	showScrollToTop?: boolean;
	/** Позиция кнопки «Наверх» (только при showScrollToTop) */
	scrollToTopVariant?: 'default' | 'blog';
	showOfficeWidget?: boolean;
	/** Виджет офиса (карточка «Связаться» + мессенджеры) */
	officeWidgetVariant?: 'default' | 'corp';
	/** Показывать Schema.org JSON-LD (для страниц вроде cabinet/terms/privacy — false) */
	showSchema?: boolean;
	/** Meta robots (404 — noindex; по умолчанию max-image-preview:large) */
	robots?: string;
	/** Open Graph type (страницы журнала — article) */
	ogType?: 'website' | 'article';
	/** ISO 8601 — для og:article:published_time */
	articlePublishedTime?: string;
	/** ISO 8601 — для og:article:modified_time */
	articleModifiedTime?: string;
}

const {
	title,
	description = 'ANRO TRIP — Путешествия, которые меняют жизнь.',
	canonicalURL,
	ogImage = '/og-image.png',
	showFavorites = true,
	showScrollProgress = true,
	showScrollToTop = true,
	scrollToTopVariant = 'default',
	showOfficeWidget = true,
	officeWidgetVariant = 'default',
	showSchema = true,
	robots = 'max-image-preview:large',
	ogType = 'website',
	articlePublishedTime,
	articleModifiedTime,
} = Astro.props;

const ogImageCanonicalPath = '/og-image.png';

const ogImageVersion = import.meta.env.OG_IMAGE_VERSION ?? '';

const baseUrl = getPublicOrigin(
	Astro.request,
	Astro.url.origin,
	Astro.site?.origin,
);
const base = siteHome();
const basePath = new URL(base, baseUrl).pathname.replace(/\/$/, '') || '/';
const canonical =
	canonicalURL ??
	new URL(`${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`, baseUrl)
		.href;
const ogImageUrl = resolveOgImageUrl(ogImage, baseUrl, ogImageVersion);
const ogImageType = ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg';

/** Стабильный id организации для связи филиалов (LocalBusiness) с TravelAgency */
const organizationId = `${baseUrl}/#organization`;
const parentOrganization = { '@id': organizationId };

const { phones, offices, brand } = company;
const chelyabinskOffice = offices.chelyabinsk;
const ekaterinburgOffice = offices.ekaterinburg;

/** Сводный рейтинг с Яндекс Карт и 2ГИС (external-reviews.ts) */
const aggregateRatingSchema = buildAggregateRatingSchema();

const chelyabinskGeo = {
	'@type': 'GeoCoordinates',
	latitude: chelyabinskOffice.geo.latitude,
	longitude: chelyabinskOffice.geo.longitude,
};

/** JSON-LD TravelAgency — корневая сущность; url сайта, не canonical страницы */
const travelAgencySchema = {
	'@type': 'TravelAgency',
	'@id': organizationId,
	name: brand,
	description:
		'Туристическая компания. Более 18 лет организуем путешествия и командировки по всему миру.',
	url: baseUrl,
	logo: `${baseUrl}${ogImageCanonicalPath}`,
	image: `${baseUrl}${ogImageCanonicalPath}`,
	telephone: phones.tollFree.e164,
	priceRange: '₽₽',
	address: {
		'@type': 'PostalAddress',
		streetAddress: chelyabinskOffice.address.streetAddress,
		addressLocality: chelyabinskOffice.address.locality,
		postalCode: chelyabinskOffice.address.postalCode,
		addressCountry: chelyabinskOffice.address.country,
	},
	geo: chelyabinskGeo,
	aggregateRating: aggregateRatingSchema,
	areaServed: [
		{ '@type': 'City', name: 'Челябинск' },
		{ '@type': 'City', name: 'Екатеринбург' },
		{ '@type': 'City', name: 'Москва' },
		{ '@type': 'Country', name: 'Россия' },
	],
	sameAs: [...companySameAs],
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: phones.tollFree.e164,
		contactType: 'customer service',
		availableLanguage: 'Russian',
	},
};

/**
 * Офисы: адреса как в Contacts/Footer.
 * Екатеринбург — на сайте без улицы (представительство), в разметке только город и регион.
 */
const localBusinessEkaterinburg = {
	'@type': 'LocalBusiness',
	'@id': `${baseUrl}/#localbusiness-ekaterinburg`,
	name: ekaterinburgOffice.name,
	description:
		'Представительство туристической компании ANRO TRIP в Екатеринбурге. Встреча по предварительной договорённости.',
	image: ogImageUrl,
	url: baseUrl,
	telephone: phones.tollFree.e164,
	priceRange: '₽₽',
	address: {
		'@type': 'PostalAddress',
		addressLocality: ekaterinburgOffice.address.locality,
		addressRegion: ekaterinburgOffice.address.region,
		addressCountry: ekaterinburgOffice.address.country,
	},
	parentOrganization,
};

const localBusinessChelyabinsk = {
	'@type': 'LocalBusiness',
	'@id': `${baseUrl}/#localbusiness-chelyabinsk`,
	name: chelyabinskOffice.name,
	description:
		'Офис туристической компании ANRO TRIP в Челябинске. Пн–пт 9:00–18:00, сб–вс по договорённости.',
	image: ogImageUrl,
	url: baseUrl,
	telephone: phones.chelyabinskOffice.e164,
	priceRange: '₽₽',
	address: {
		'@type': 'PostalAddress',
		streetAddress: chelyabinskOffice.address.streetAddress,
		addressLocality: chelyabinskOffice.address.locality,
		postalCode: chelyabinskOffice.address.postalCode,
		addressCountry: chelyabinskOffice.address.country,
	},
	parentOrganization,
	geo: chelyabinskGeo,
	aggregateRating: aggregateRatingSchema,
	sameAs: [yandexReviewsUrl, twoGisReviewsUrl],
	openingHoursSpecification: chelyabinskOffice.openingHours.specification.map(
		(item) => ({
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: [...item.dayOfWeek],
			opens: item.opens,
			closes: item.closes,
		}),
	),
};

const websiteSchema = {
	'@type': 'WebSite',
	'@id': `${baseUrl}/#website`,
	url: baseUrl,
	name: brand,
	inLanguage: 'ru-RU',
	publisher: { '@id': organizationId },
};

/** Один блок JSON-LD: TravelAgency + филиалы + WebSite */
const schemaOrgGraph = {
	'@context': 'https://schema.org',
	'@graph': [
		websiteSchema,
		travelAgencySchema,
		localBusinessEkaterinburg,
		localBusinessChelyabinsk,
	],
};
---

<!doctype html>
<html lang="ru" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="only light" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#00abb3" />
		<meta name="geo.region" content="RU-CHE" />

		<link rel="alternate" hreflang="ru" href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />

		{
			import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
				<meta
					name="google-site-verification"
					content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
				/>
			)
		}
		{
			import.meta.env.PUBLIC_YANDEX_VERIFICATION && (
				<meta
					name="yandex-verification"
					content={import.meta.env.PUBLIC_YANDEX_VERIFICATION}
				/>
			)
		}

		<!-- Favicon (из assets — оптимизируется при сборке) -->
		<link rel="icon" type="image/png" href={favicon.src} />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta name="robots" content={robots} />

		<link rel="canonical" href={canonical} />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="ANRO TRIP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content={ogImageType} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="ANRO TRIP" />
		<meta property="og:locale" content="ru_RU" />
		{
			ogType === 'article' && articlePublishedTime && (
				<meta
					property="article:published_time"
					content={articlePublishedTime}
				/>
			)
		}
		{
			ogType === 'article' && articleModifiedTime && (
				<meta property="article:modified_time" content={articleModifiedTime} />
			)
		}

		<!-- Twitter / X Card (превью при шеринге; дублирует OG для совместимости с X и краулерами) -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="ANRO TRIP" />

		<!-- Schema.org JSON-LD -->
		{
			showSchema && (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(schemaOrgGraph)}
				/>
			)
		}

		<script define:vars={{ basePath }}>
			import { initPendingHomeAnchor } from '../lib/client/pending-home-anchor.ts';

			initPendingHomeAnchor(basePath);
		</script>

		<ClientRouter />

		<title>{title}</title>
		<slot name="head" />
	</head>
	<body
		class="bg-white text-gray-900 font-inter antialiased overflow-x-hidden selection:bg-primary/20 selection:text-primary-dark"
		data-base={base}
	>
		{
			/* Плавный скролл, scroll reveal и блокировка скролла — src/lib/client/*.ts */
		}
		<script>
			import { createFocusTrap } from '../lib/client/focus-trap.ts';
			import { lockScroll, unlockScroll } from '../lib/client/scroll-lock.ts';
			import { initScrollReveal } from '../lib/client/scroll-reveal.ts';
			import {
				initAnchorSmoothScroll,
				smoothScrollIntoView,
				smoothScrollTo,
			} from '../lib/client/smooth-scroll.ts';

			window.createFocusTrap = createFocusTrap;
			window.lockScroll = lockScroll;
			window.unlockScroll = unlockScroll;
			window.smoothScrollTo = smoothScrollTo;
			window.smoothScrollIntoView = smoothScrollIntoView;
			window.initScrollReveal = initScrollReveal;

			initAnchorSmoothScroll();
			initScrollReveal();

			document.addEventListener('astro:before-swap', () => {
				document.documentElement.classList.add('is-route-swapping');
			});

			document.addEventListener('astro:page-load', () => {
				document.documentElement.classList.remove('is-route-swapping');
				requestAnimationFrame(() => {
					window.initScrollReveal?.();
					window.initSearchWidget?.();
					window.initNemoWidget?.();
				});
			});
		</script>
		{/* Skip Link: виден при фокусе (Tab), для клавиатуры и скринридеров */}
		<a
			href="#content"
			class="fixed left-4 top-0 z-overlay-top -translate-y-full rounded-b-md bg-primary px-4 py-2.5 text-sm font-semibold text-white focus:shadow-lg transition-transform duration-fast focus:translate-y-0 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
		>
			Перейти к содержимому
		</a>
		{showScrollProgress && <ScrollProgress />}
		<slot />
		{showScrollToTop && <ScrollToTop variant={scrollToTopVariant} />}
		{showFavorites && <FavoritesWidget />}
		{showOfficeWidget && <OfficeWidget variant={officeWidgetVariant} />}
		<CookieBanner />
		<GiftModal />
		<CallbackModal />
		{
			/* Tourvisor не поддерживает View Transition → полная перезагрузка при переходе на главную; при «Назад» из bfcache тоже перезагружаем */
		}
		<script>
			import { initLayoutNavigation } from '../lib/client/layout-navigation.ts';

			initLayoutNavigation();
		</script>
	</body>
</html>
