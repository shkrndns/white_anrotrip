---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getTourStyleBadge } from '../../lib/tourDestinationBadge';
import { siteBlogPost } from '../../lib/site-urls';

interface Props {
	post: CollectionEntry<'blog'>;
	title: string;
	titleHtml: string;
	description: string;
}

const { post, title, titleHtml, description } = Astro.props;
---

<article
	class="group md:col-span-3 flex flex-col lg:flex-row rounded-3xl overflow-hidden bg-white border border-primary/15 shadow-[0_8px_40px_rgba(0,171,179,0.18)] hover:shadow-[0_12px_48px_rgba(0,171,179,0.28)] transition-[opacity,transform,box-shadow] duration-slow [content-visibility:auto]"
>
	<a
		href={siteBlogPost(post.id)}
		class="relative block overflow-hidden aspect-16/10 lg:w-[58%] lg:shrink-0 lg:aspect-auto lg:min-h-[min(22rem,52vh)]"
		aria-label={`Читать статью: ${title}`}
	>
		{
			post.data.heroImages && post.data.heroImages.length >= 2 ? (
				<div
					class="absolute inset-0 transition-transform duration-slow ease-out group-hover:scale-[1.02]"
					data-slideshow={`card-featured-${post.id}`}
				>
					{post.data.heroImages.slice(0, 8).map((img, i) => (
						<div
							class="absolute inset-0 transition-opacity duration-1000 ease-in-out"
							data-slide={i}
							data-slideshow-group={`card-featured-${post.id}`}
						>
							<Image
								src={img}
								alt={`${post.data.title} — фото ${i + 1}`}
								width={1200}
								height={675}
								loading={i === 0 ? 'eager' : 'lazy'}
								class="w-full h-full object-cover"
							/>
						</div>
					))}
				</div>
			) : (post.data.cardImage ?? post.data.heroImage) ? (
				<Image
					src={post.data.cardImage ?? post.data.heroImage!}
					alt={post.data.title}
					width={1200}
					height={675}
					loading="eager"
					class="object-cover w-full h-full transition-transform duration-slow ease-out group-hover:scale-[1.02]"
				/>
			) : (
				<div
					class="blog-card-placeholder w-full h-full min-h-48"
					role="img"
					aria-label="Место для фото"
				>
					<svg
						class="blog-media-placeholder__icon blog-media-placeholder__icon--lg"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						aria-hidden="true"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="1.5"
							d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
						/>
					</svg>
					<span class="blog-media-placeholder__label">Фото скоро</span>
				</div>
			)
		}
		<div class="absolute top-4 left-4 flex flex-wrap items-center gap-2">
			<span
				class="bg-red text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider shadow-sm"
			>
				Выбор редакции
			</span>
			{
				post.data.destination && (
					<span
						class:list={[
							'inline-block rounded-full px-3 py-1 text-[10px] font-black uppercase tracking-wider',
							getTourStyleBadge(post.data.destination).className,
						]}
					>
						{getTourStyleBadge(post.data.destination).label}
					</span>
				)
			}
		</div>
	</a>

	<div
		class="relative overflow-hidden p-6 md:p-8 lg:p-10 flex flex-col grow lg:max-w-[42%]"
	>
		<div
			class="absolute top-0 right-0 size-52 rounded-full bg-primary/7 blur-none md:blur-2xl pointer-events-none translate-x-1/3 -translate-y-1/3"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute bottom-0 left-0 size-40 rounded-full bg-secondary/6 blur-none md:blur-2xl pointer-events-none -translate-x-1/3 translate-y-1/3"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute bottom-1/3 right-4 size-24 rounded-full bg-primary/8 blur-none md:blur-xl pointer-events-none"
			aria-hidden="true"
		>
		</div>
		<time
			datetime={post.data.pubDate.toISOString()}
			class="text-xs text-gray-500 font-inter mb-3 block"
		>
			{
				post.data.pubDate.toLocaleDateString('ru-RU', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				})
			}
		</time>
		<h2
			class="text-xl md:text-2xl lg:text-[1.65rem] font-extrabold text-gray-900 mb-3 font-montserrat leading-tight tracking-tight line-clamp-3 group-hover:text-primary transition-colors duration-fast"
		>
			<a href={siteBlogPost(post.id)} set:html={titleHtml} />
		</h2>
		<p
			class="text-sm md:text-base text-gray-600 line-clamp-4 mb-6 grow font-inter leading-relaxed"
		>
			{description}
		</p>
		<div
			class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100 mt-auto"
		>
			<span class="text-xs font-semibold text-gray-500 font-inter"
				>{post.data.author}</span
			>
			<a
				href={siteBlogPost(post.id)}
				class="group/link inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-dark transition-colors duration-fast font-montserrat uppercase tracking-wide"
				aria-label={`Читать: ${title}`}
			>
				Читать материал
				<svg
					class="w-4 h-4 group-hover/link:translate-x-0.5 transition-transform duration-fast"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					aria-hidden="true"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2.5"
						d="M9 5l7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</div>
</article>
