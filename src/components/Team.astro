---
// src/components/Team.astro
// cspell:words ANRO anrotrip anro Rozhkova rozhkova Rozhkov rozhkov Denisova denisova Nedelko nedelko Sherbakova sherbakova Mosinceva mosinceva Koroleva koroleva Subotina subotina Semushina semushina Dankova dankova Ledneva ledneva Tsypysheva tsypysheva Musina musina Bochkareva bochkareva Krestovskich krestovskich Golovanova golovanova Pasynkova pasynkova Bateneva bateneva Golikova golikova Domashevskaya domashevskaya Mamykina mamykina Mamikina Vafina vafina Nagovicyna nagovicyna
import { Image } from 'astro:assets';
import FaIcon from './icons/FaIcon.astro';
import SectionHeading from './ui/SectionHeading.astro';

import annaRozhkovaImg from '../assets/team/a_rozhkova.webp';
import nikitaRozhkovImg from '../assets/team/n_rozhkov.webp';
import teamGroupImg from '../assets/team/team.webp';

import { teamMembers as team } from '../data/team';

/** tel: для «8 (800) … доб. 115» → tel:88002224473,115 (не склеивать цифры добавочного с основным) */
function phoneToTelHref(phone: string): string {
	const ext = phone.match(/доб\.?\s*(\d+)/iu);
	const main = phone.replace(/доб\.?\s*\d+/giu, '').replace(/[^\d+]/g, '');
	if (ext?.[1]) return `tel:${main},${ext[1]}`;
	return `tel:${main}`;
}
---

<!-- ═══ ОСНОВАТЕЛИ ═══ -->
<section
	id="team"
	class="relative pt-[50px] pb-[50px] bg-gray-950 text-white overflow-hidden"
>
	<!-- Декор -->
	<div
		class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-size-[60px_60px] pointer-events-none"
	>
	</div>
	<div
		class="absolute top-0 right-0 w-96 h-96 bg-primary/8 rounded-full blur-none md:blur-3xl pointer-events-none translate-x-1/2 -translate-y-1/2"
	>
	</div>

	<div class="container mx-auto px-4 sm:px-6 max-w-7xl relative z-10">
		<!-- Заголовок -->
		<div
			class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-3.5 md:mb-5.5 reveal-hidden"
		>
			<div>
				<SectionHeading
					badge="Команда"
					headingClass="section-heading-plus font-montserrat font-extrabold text-white uppercase tracking-tight"
				>
					Команда<br />
					<span class="text-primary">ANRO TRIP</span>
				</SectionHeading>
			</div>
			<p class="section-caption section-caption--on-dark">
				Профессионалы, которые делают ваши путешествия идеальными — с первого
				звонка до возвращения домой
			</p>
		</div>

		<!-- Основатели + групповое фото: мобайл — колонка, десктоп — 3 в ряд (групповое шире) -->
		<div
			class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_2fr] gap-4 md:gap-5 mb-14"
			data-reveal-stagger
		>
			<!-- Анна Рожкова -->
			<div class="reveal-hidden">
				<div
					class="team-founder-card group relative overflow-hidden rounded-3xl bg-white/5 border border-white/8 flex flex-col"
				>
					<!-- Без градиента — артефакт исчез (градиент конфликтовал с рендерингом при scale) -->
					<div
						class="relative overflow-hidden h-[320px] sm:h-[360px] bg-gray-900"
					>
						<Image
							src={annaRozhkovaImg}
							alt="Анна Рожкова"
							class="w-full h-full -translate-y-8 object-cover object-[50%_45%] scale-[1.32] transition-transform duration-slow ease-out group-hover:scale-[1.36]"
							loading="lazy"
						/>
					</div>
					<!-- Подпись внизу -->
					<div class="relative px-5 py-4 bg-white/4">
						<h3
							class="font-montserrat font-extrabold text-white text-lg leading-tight"
						>
							Анна Рожкова
						</h3>
						<p class="text-white/45 text-[10px] uppercase tracking-widest mt-1">
							Основатель и генеральный директор
						</p>
					</div>
				</div>
			</div>

			<!-- Никита Рожков -->
			<div class="reveal-hidden">
				<div
					class="team-founder-card group relative overflow-hidden rounded-3xl bg-white/5 border border-white/8 flex flex-col"
				>
					<div
						class="relative overflow-hidden h-[320px] sm:h-[360px] bg-gray-900"
					>
						<Image
							src={nikitaRozhkovImg}
							alt="Никита Рожков"
							class="w-full h-full -translate-y-4 object-cover object-[50%_32%] scale-[1.32] transition-transform duration-slow ease-out group-hover:scale-[1.36]"
							loading="lazy"
						/>
					</div>
					<div class="relative px-5 py-4 bg-white/4">
						<h3
							class="font-montserrat font-extrabold text-white text-lg leading-tight"
						>
							Никита Рожков
						</h3>
						<p class="text-white/45 text-[10px] uppercase tracking-widest mt-1">
							Исполнительный директор
						</p>
					</div>
				</div>
			</div>

			<!-- Групповое фото команды -->
			<div class="reveal-hidden">
				<div
					class="team-founder-card group relative overflow-hidden rounded-3xl bg-white/5 border border-white/8 flex flex-col"
				>
					<div
						class="relative overflow-hidden h-[320px] sm:h-[360px] bg-gray-900"
					>
						<Image
							src={teamGroupImg}
							alt="Команда ANRO TRIP"
							class="w-full h-full object-cover transition-transform duration-slow ease-out group-hover:scale-[1.04]"
							loading="lazy"
						/>
					</div>
					<div class="relative px-5 py-4 bg-white/4">
						<h3
							class="font-montserrat font-extrabold text-white text-lg leading-tight"
						>
							Наша команда
						</h3>
						<p class="text-white/45 text-[10px] uppercase tracking-widest mt-1">
							Специалисты · Авиа · Туры · Визы
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Кнопка: открыть / свернуть список (всегда на месте) -->
	<div class="flex justify-center relative z-20" id="team-btn-wrapper">
		<button
			type="button"
			id="toggle-team-btn"
			aria-expanded="false"
			aria-controls="team-list"
			class="team-toggle-btn inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-white/10 border border-primary/15 text-white font-bold text-sm uppercase tracking-wider hover:bg-white/18 btn-ripple cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 transition-[background-color,box-shadow] duration-slow ease-out"
		>
			<FaIcon
				name="fa6-solid:users"
				iconClass="text-base leading-none shrink-0 text-primary"
			/>
			<span class="team-btn-label font-montserrat">Вся команда</span>
			<FaIcon
				name="fa6-solid:chevron-down"
				iconClass="team-btn-chevron text-sm leading-none shrink-0 text-primary transition-transform duration-slow ease-out"
			/>
		</button>
	</div>
</section>

<!-- ═══ ВСЯ КОМАНДА ═══ -->
<section
	id="team-list"
	class="team-list-panel relative bg-gray-50 overflow-hidden transition-[max-height,opacity] duration-slow ease-in-out opacity-0 hidden border-t border-gray-100 motion-reduce:transition-none"
	aria-hidden="true"
>
	<div class="container mx-auto px-4 sm:px-6 max-w-7xl py-[50px]">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
			{
				team.map((member) => (
					<div class="flex flex-col items-center text-center group">
						<div class="w-40 h-40 sm:w-48 sm:h-48 rounded-4xl overflow-hidden mb-5 ring-2 ring-gray-100 group-hover:ring-primary/30 group-hover:shadow-xl transition-all duration-slow ease-out bg-gray-200 shrink-0">
							<Image
								src={member.img}
								alt={member.name}
								class:list={[
									'h-full w-full object-cover transition-transform duration-slow ease-out',
									member.photoClass ?? 'group-hover:scale-[1.04]',
								]}
								loading="lazy"
							/>
						</div>

						<h3 class="font-montserrat font-bold text-gray-900 text-lg leading-tight mb-1">
							{member.name}
						</h3>
						<p class="text-[13px] text-gray-400 leading-snug">{member.role}</p>
						{member.dept && (
							<p class="text-[13px] text-gray-400 mb-2 leading-snug">
								{member.dept}
							</p>
						)}

						<div class="w-full">
							<a
								href={`mailto:${member.email}`}
								class="block text-[13px] text-primary hover:text-secondary transition-colors font-medium truncate px-1 cursor-pointer"
								title={member.email}
							>
								{member.email}
							</a>
							{member.phone && (
								<a
									href={phoneToTelHref(member.phone)}
									class="block text-[13px] text-primary hover:text-secondary transition-colors truncate px-1 mb-6 cursor-pointer"
									title={member.phone}
								>
									{member.phone}
								</a>
							)}
						</div>
					</div>
				))
			}
		</div>

		<!-- Свернуть список — после всех фото (как в главной кнопке «Вся команда») -->
		<div class="flex justify-center mt-12 md:mt-14">
			<button
				type="button"
				id="team-collapse-bottom"
				class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-white px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-primary shadow-sm transition-[color,background-color,transform,box-shadow] duration-slow ease-out hover:bg-primary/10 hover:border-primary/35 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-gray-50 md:text-sm"
			>
				<FaIcon
					name="fa6-solid:chevron-up"
					iconClass="text-sm leading-none shrink-0"
				/>
				Свернуть
			</button>
		</div>
	</div>
</section>

<script>
	import { initTeamListToggle } from '../lib/client/team-list-toggle.ts';

	function runInit() {
		initTeamListToggle();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', runInit);
	} else {
		runInit();
	}
	document.addEventListener('astro:page-load', runInit);
</script>
